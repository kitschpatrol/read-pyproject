{
	"name": "read-pyproject",
	"version": "0.4.2",
	"description": "Parse and normalize pyproject.toml metadata into strictly typed JavaScript objects.",
	"keywords": [
		"python",
		"pep-518",
		"pyproject",
		"toml",
		"npm-package"
	],
	"homepage": "https://github.com/kitschpatrol/read-pyproject",
	"bugs": "https://github.com/kitschpatrol/read-pyproject/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/read-pyproject.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX",
		"fix": "ksc fix",
		"lint": "ksc lint",
		"release": "bumpp --commit 'Release: %s' --all --execute 'chagent' && pnpm build && pnpm publish --otp $(op item get npm --otp)",
		"test": "vitest run"
	},
	"dependencies": {
		"lognow": "^0.8.7",
		"smol-toml": "^1.9.1",
		"spdx-correct": "^3.2.0",
		"spdx-expression-validate": "^2.0.0",
		"type-fest": "^5.10.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@kitschpatrol/chagent": "^0.5.0",
		"@kitschpatrol/shared-config": "^8.14.0",
		"@types/node": "~20.19.43",
		"@types/spdx-correct": "^3.1.3",
		"bumpp": "^12.3.0",
		"publint": "^0.3.25",
		"shx": "^0.4.0",
		"tsdown": "^0.23.4",
		"typescript": "~6.0.3",
		"vitest": "^5.0.5"
	},
	"packageManager": "pnpm@12.16.1",
	"engines": {
		"node": "^20.19.0 || ^22.9.0 || ^24.0.0 || >=26.0.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24.16.0 || >=26.3.0"
		}
	}
}
