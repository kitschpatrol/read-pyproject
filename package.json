{
	"name": "read-pyproject",
	"version": "0.3.3",
	"description": "Parse and normalize pyproject.toml metadata into strictly typed JavaScript objects.",
	"keywords": [
		"python",
		"pep-518",
		"pyproject",
		"toml",
		"npm-package"
	],
	"homepage": "https://github.com/kitschpatrol/read-pyproject",
	"bugs": "https://github.com/kitschpatrol/read-pyproject/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/read-pyproject.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"files": [
		"dist/*"
	],
	"scripts": {
		"build": "tsdown",
		"clean": "shx rm -f pnpm-lock.yaml && git clean -fdX -e !.claude/",
		"fix": "ksc fix",
		"lint": "ksc lint",
		"release": "bumpp --commit 'Release: %s' && pnpm build && NPM_AUTH_TOKEN=$(op read 'op://Personal/npm/token') pnpm publish",
		"test": "vitest run"
	},
	"dependencies": {
		"lognow": "^0.6.2",
		"smol-toml": "^1.6.1",
		"spdx-correct": "^3.2.0",
		"spdx-expression-validate": "^2.0.0",
		"type-fest": "^5.6.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.2",
		"@kitschpatrol/shared-config": "^7.6.0",
		"@types/node": "~22.18.13",
		"@types/spdx-correct": "^3.1.3",
		"bumpp": "^11.1.0",
		"publint": "^0.3.21",
		"shx": "^0.4.0",
		"tsdown": "^0.22.0",
		"typescript": "~5.9.3",
		"vitest": "^4.1.6"
	},
	"packageManager": "pnpm@11.1.2",
	"engines": {
		"node": ">=20.17.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=22.18.0"
		}
	}
}
